# ==========================================
# HackEval Backend Configuration
# ==========================================

# Supabase Database & Auth (Required)
# Retrieve these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# Celery Task Queue & Redis (Required for async pipeline)
# Default for local Redis: redis://localhost:6379/0
# Inside Docker Compose: redis://redis:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Qdrant Vector Engine (Semantic slide vector search)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# AI Evaluator / LLM Judge
# Connect to your local or cloud vLLM / Prometheus instance
PROMETHEUS_URL=http://localhost:8000/v1
VLLM_MODEL=prometheus-eval/prometheus-7b-v2.0

# Optional API Keys (e.g. Groq for fast fallback LLM processing)
GROQ_API=
